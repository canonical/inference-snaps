{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Update all submodules in a single PR",
      "matchManagers": ["git-submodules"],
      "groupName": "all-submodules",
      "schedule": ["on monday"],
      "commitBody": "[skip ci]",
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": true
    }
  ]
}
